# Dependencies
node_modules/
**/node_modules/

# Environment Variables & Configs (Strictly ignore all .env files)
.env
.env*
**/.env*
*.env*

# User Uploaded Storage (Keep directory, ignore contents)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Database Files & SQLite Journals
data/
**/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Production Build Output
client/dist/
dist/
**/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Cache Files
.cache/
.tmp/
.temp/
.tempmediaStorage/
