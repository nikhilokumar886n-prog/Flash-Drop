# FlashDrop Configuration

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5001

# Cloud PostgreSQL Connection (Neon, Supabase, Vercel Postgres, Render)
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Application Settings
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_SHARE=20
MAX_SHARE_EXPIRY_HOURS=24
CLEANUP_INTERVAL_SECONDS=60

# Rate Limiting
CODE_RATE_LIMIT_WINDOW_MINUTES=15
CODE_RATE_LIMIT_MAX_ATTEMPTS=15
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=30

# Storage Engine (Options: local | s3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# S3 / Supabase / Cloudflare R2 Storage (Optional, only required if STORAGE_TYPE=s3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=flashdrop-uploads
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
